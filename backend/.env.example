# Groq API credentials. The backend will fail to start if GROQ_API_KEY is not set.
GROQ_API_KEY=your-groq-api-key-here

# LLM model name used by the AI routing layer (LangChain + ChatGroq).
GROQ_MODEL=llama3-70b-8192

# Comma-separated list of allowed CORS origins for the FastAPI service.
# Example: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173
